# =================================
# Application Configuration
# =================================
NODE_ENV=development
LOG_LEVEL=info
API_VERSION=v1

# =================================
# Service Ports
# =================================
API_GATEWAY_PORT=3000
USER_SERVICE_PORT=3001
PRODUCT_SERVICE_PORT=3002
ORDER_SERVICE_PORT=3003

# =================================
# Database & Persistence Configuration
# =================================
# Mode: "server" (uses PostgreSQL, MongoDB, Redis) or "embedded" (uses SQLite, NeDB, RocksDB)
DB_MODE=server

# ---------------------------------
# 1. Relational Database (User & Order Services)
# ---------------------------------
# Options: "postgres" | "sqlite"
RELATIONAL_DB_DRIVER=postgres

# PostgreSQL Configuration (used when RELATIONAL_DB_DRIVER=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=ecommerce
DATABASE_URL=postgresql://postgres:password@localhost:5432/ecommerce?schema=public

# SQLite Configuration (used when RELATIONAL_DB_DRIVER=sqlite or DB_MODE=embedded)
SQLITE_DB_PATH=./data/ecommerce.db

# ---------------------------------
# 2. Document Database (Product Catalog & Sessions)
# ---------------------------------
# Options: "mongodb" | "nedb"
DOCUMENT_DB_DRIVER=mongodb

# MongoDB Configuration (used when DOCUMENT_DB_DRIVER=mongodb)
MONGODB_URI=mongodb://localhost:27017/ecommerce_sessions

# NeDB Embedded Configuration (used when DOCUMENT_DB_DRIVER=nedb or DB_MODE=embedded)
NEDB_DATA_PATH=./data/nedb
NEDB_IN_MEMORY=false

# ---------------------------------
# 3. Key-Value Cache & Message Broker
# ---------------------------------
# Options: "redis" | "rocksdb" | "embedded"
KV_CACHE_DRIVER=redis

# Redis Configuration (used when KV_CACHE_DRIVER=redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RocksDB / Embedded KV Configuration (used when KV_CACHE_DRIVER=rocksdb/embedded or DB_MODE=embedded)
ROCKSDB_DATA_PATH=./data/rocksdb
EMBEDDED_KV_IN_MEMORY=false

# =================================
# Authentication & Security
# =================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key
JWT_REFRESH_EXPIRES_IN=30d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# =================================
# External Service APIs
# =================================
# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# PayPal
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# Email Service (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@ecommerce.com
FROM_NAME=ECommerce Platform

# =================================
# Object & File Storage (RustFS / S3)
# =================================
# Storage Provider: "rustfs" (high-performance Rust-based S3 object storage) | "s3" | "local"
STORAGE_PROVIDER=rustfs

# RustFS Distributed Object Storage (https://github.com/rustfs/rustfs - S3 API Compatible)
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_CONSOLE_ENDPOINT=http://localhost:9001
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfspassword
RUSTFS_BUCKET=ecommerce-uploads
RUSTFS_REGION=us-east-1
RUSTFS_USE_SSL=false

# Legacy AWS S3 Compatibility Fallback (used when STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=ecommerce-uploads
AWS_S3_ENDPOINT=

# Local File Storage Fallback (used when STORAGE_PROVIDER=local)
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# =================================
# Search & Analytics
# =================================
# Elasticsearch
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_INDEX=products

# Google Analytics
GA_MEASUREMENT_ID=GA_MEASUREMENT_ID

# =================================
# Distributed Task Queues (BullMQ)
# =================================
# BullMQ runs on Redis (configured in Redis section above)
BULLMQ_CONCURRENCY=10
BULLMQ_ORDER_EXPIRATION_MINUTES=15
BULLMQ_MAX_RETRIES=5

# =================================
# External Integrations
# =================================
# Shipping API
SHIPPING_API_KEY=your-shipping-api-key
SHIPPING_API_URL=https://api.shipping.com

# Tax Service API
TAX_API_KEY=your-tax-api-key
TAX_API_URL=https://api.taxservice.com

# Inventory Management
INVENTORY_SERVICE_URL=http://localhost:3004

# Notification Service
NOTIFICATION_SERVICE_URL=http://localhost:3005

# =================================
# Monitoring & Observability
# =================================
# Sentry (Error Tracking)
SENTRY_DSN=your-sentry-dsn

# Datadog (Monitoring)
DATADOG_API_KEY=your-datadog-api-key
DATADOG_APP_KEY=your-datadog-app-key

# Prometheus Metrics
PROMETHEUS_PORT=9090

# =================================
# Rate Limiting
# =================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =================================
# CORS Configuration
# =================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://yourdomain.com

# =================================
# Development Only
# =================================
# Mock External APIs
MOCK_EXTERNAL_APIS=true

# Enable Debug Mode
DEBUG=true

# Seed Database on Start
SEED_DATABASE=true