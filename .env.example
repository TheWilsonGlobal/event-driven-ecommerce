# =================================
# Application Configuration
# =================================
NODE_ENV=development
LOG_LEVEL=info
API_VERSION=v1

# =================================
# Service Ports
# =================================
API_GATEWAY_PORT=5460
ADMIN_PORT=5461
CLIENT_PORT=5462
USER_SERVICE_PORT=5463
PRODUCT_SERVICE_PORT=5464
ORDER_SERVICE_PORT=5465
INVENTORY_SERVICE_PORT=5466
ANALYTICS_SERVICE_PORT=5467

# =================================
# Database & Persistence Configuration
# =================================
# PROPOSED (change-03-db-upgrade): every service stores its data in ONE Supabase
# Postgres database, one schema per service. See
# .notes/JOBs/fse/event-driven-ecommerce/change-03-db-upgrade/supabase-single-db-plan.md
# Not wired up yet -- the services still read the embedded settings until the
# plan is approved and implemented.
#
# Mode: "supabase" (single Postgres) | "server" (legacy: PostgreSQL, MongoDB, Redis) | "embedded" (legacy: SQLite, NeDB)
DB_MODE=supabase

# ---------------------------------
# 1. Supabase project
# ---------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# Client-safe API key. No browser code in this repo needs it today.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
# SERVER-ONLY. Bypasses RLS. Never expose through the client (Next) or admin (Vite) env prefixes.
SUPABASE_SECRET_KEY=sb_secret_your-secret-key

# ---------------------------------
# 2. Postgres connection (needs the DATABASE PASSWORD from Dashboard -> Connect)
# ---------------------------------
# The connection base is written ONCE. Every service derives its own URLs from it:
#     <SERVICE>_DATABASE_URL = ${SUPABASE_DB_URL}/postgres?schema=ms_<service>   (runtime)
#     <SERVICE>_DIRECT_URL   = same value                                       (migrations)
# for user, order, product, inventory, analytics (schemas ms_user, ms_order, ms_product,
# ms_inventory, ms_analytics).
# A password containing @ # % ^ $ must be percent-encoded (@ = %40, # = %23, % = %25, ^ = %5E, $ = %24).
RELATIONAL_DB_DRIVER=postgres
DOCUMENT_DB_DRIVER=postgres
SUPABASE_DB_URL=postgresql://postgres:your-encoded-password@db.your-project-ref.supabase.co:5432

# Optional override for ONE service (an explicit value always wins). Example: run the
# runtime on the transaction pooler (port 6543, pgbouncer=true) but migrate on 5432:
# ORDER_DATABASE_URL=postgresql://postgres.your-project-ref:your-encoded-password@aws-0-your-region.pooler.supabase.com:6543/postgres?schema=ms_order&pgbouncer=true
# ORDER_DIRECT_URL=postgresql://postgres.your-project-ref:your-encoded-password@aws-0-your-region.pooler.supabase.com:5432/postgres?schema=ms_order

# Connections per service. 5 services x this value must stay under the project's connection cap.
DB_POOL_MAX=3

# ---------------------------------
# 3. Transactional outbox relay (ms-order, ms-inventory)
# ---------------------------------
OUTBOX_POLL_MS=500
OUTBOX_BATCH=50
OUTBOX_MAX_ATTEMPTS=10
# Lease must be greater than the send timeout; the service refuses to boot otherwise.
OUTBOX_LEASE_MS=60000
OUTBOX_SEND_TIMEOUT_MS=10000

# ---------------------------------
# Legacy embedded / self-hosted settings (removed after cutover, Phase 5)
# ---------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=ecommerce
DATABASE_URL=postgresql://postgres:password@localhost:5432/ecommerce?schema=public
SQLITE_DB_PATH=./data/ecommerce.db
MONGODB_URI=mongodb://localhost:27017/ecommerce_sessions
NEDB_DATA_PATH=./data/nedb
NEDB_IN_MEMORY=false

# ---------------------------------
# 4. Key-Value Cache & Message Broker
# ---------------------------------
# Options: "redis" | "rocksdb" | "embedded"
KV_CACHE_DRIVER=redis

# Redis Configuration (used when KV_CACHE_DRIVER=redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RocksDB / Embedded KV Configuration (used when KV_CACHE_DRIVER=rocksdb/embedded or DB_MODE=embedded)
ROCKSDB_DATA_PATH=./data/rocksdb
EMBEDDED_KV_IN_MEMORY=false

# ---------------------------------
# 5. Object & File Storage (RustFS / S3)
# ---------------------------------
# Storage Provider: "rustfs" (high-performance Rust-based S3 object storage) | "s3" | "local"
STORAGE_PROVIDER=rustfs

# RustFS Distributed Object Storage (https://github.com/rustfs/rustfs - S3 API Compatible)
# Host ports moved off 9000/9001 to 6380/6381 on 2026-09-22 in infra-hub, which
# owns this container -- see infra-hub's .env for why.
RUSTFS_ENDPOINT=http://localhost:6380
RUSTFS_CONSOLE_ENDPOINT=http://localhost:6381
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfspassword
RUSTFS_BUCKET=ecommerce-uploads
# Host directory backing the RustFS bind mount. Owned by the infra-hub repo;
# shown read-only in the admin Persistence panel.
RUSTFS_DATA_PATH=C:\Hub\RustFS
RUSTFS_REGION=us-east-1
RUSTFS_USE_SSL=false

# Legacy AWS S3 Compatibility Fallback (used when STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=ecommerce-uploads
AWS_S3_ENDPOINT=

# Local File Storage Fallback (used when STORAGE_PROVIDER=local)
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# =================================
# Authentication & Security
# =================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key
JWT_REFRESH_EXPIRES_IN=30d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# =================================
# External Service APIs
# =================================
# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# PayPal
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# Email Service (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@ecommerce.com
FROM_NAME=ECommerce Platform

# =================================
# Logging (Loki)
# =================================
# Loki runs in infra-hub behind a compose profile:
#   cd ../infra-hub && docker compose --profile logging up -d
# Services log to the terminal regardless; this adds shipping to Loki so the
# lines become queryable in Grafana. Set false to disable shipping entirely.
LOKI_ENABLED=true
LOKI_HOST=http://localhost:3100
LOG_LEVEL=info

# =================================
# Search & Analytics
# =================================
# Elasticsearch
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_INDEX=products
# Set false to skip Elasticsearch entirely and use the in-memory substring
# fallback -- useful when the search profile is down and you would rather not
# pay the connection timeout on every ?search request.
ELASTICSEARCH_ENABLED=true

# Google Analytics
GA_MEASUREMENT_ID=GA_MEASUREMENT_ID

# =================================
# Distributed Task Queues (BullMQ)
# =================================
# BullMQ runs on Redis (configured in Redis section above)
BULLMQ_CONCURRENCY=10
BULLMQ_ORDER_EXPIRATION_MINUTES=15
BULLMQ_MAX_RETRIES=5

# =================================
# External Integrations
# =================================
# Shipping API
SHIPPING_API_KEY=your-shipping-api-key
SHIPPING_API_URL=https://api.shipping.com

# Tax Service API
TAX_API_KEY=your-tax-api-key
TAX_API_URL=https://api.taxservice.com

# Inventory Management — now the REAL ms-inventory service (port 5466).
# This used to point at the gateway's products route, which was never an
# inventory API and which nothing read; ms-inventory exists as of 2026-09-23.
INVENTORY_SERVICE_URL=http://localhost:5466

# Analytics Service (internal). A PURE CONSUMER of the event backbone: it
# publishes nothing and nothing reads what it writes, so this URL exists for
# the admin panel and for curl, not for any service-to-service call.
ANALYTICS_SERVICE_URL=http://localhost:5467

# Notification Service (internal — routed through API Gateway)
NOTIFICATION_SERVICE_URL=http://localhost:5460/api/v1/notifications

# =================================
# Monitoring & Observability
# =================================
# Sentry (Error Tracking)
SENTRY_DSN=your-sentry-dsn

# Datadog (Monitoring)
DATADOG_API_KEY=your-datadog-api-key
DATADOG_APP_KEY=your-datadog-app-key

# Prometheus Metrics
PROMETHEUS_PORT=9090

# =================================
# Rate Limiting
# =================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =================================
# CORS Configuration
# =================================
ALLOWED_ORIGINS=http://localhost:5460,http://localhost:5461,http://localhost:5462,http://localhost:5463,http://localhost:5464,http://localhost:5465,https://yourdomain.com

# =================================
# Development Only
# =================================
# Mock External APIs
MOCK_EXTERNAL_APIS=true

# Enable Debug Mode
DEBUG=true

# Seed Database on Start
SEED_DATABASE=true

# ── Event backbone (Kafka / Redpanda) ────────────────────────────────────────
# OPTIONAL and OFF by default. With KAFKA_ENABLED=false nothing is constructed,
# no sockets are opened, and GET /api/v1/events honestly reports enabled:false.
# The broker lives in the infra-hub repo:
#     cd ../../infra-hub && docker compose --profile kafka up -d
# Console (topics, messages, consumer lag): http://localhost:9102
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9100
