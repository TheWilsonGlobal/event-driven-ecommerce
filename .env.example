# Only keys that something reads are listed here. Anything not set falls back to the
# default in code. Per-service Postgres URLs are DERIVED from SUPABASE_DB_URL.

# =================================
# Application
# =================================
NODE_ENV=development
LOG_LEVEL=info

# =================================
# Service Ports
# =================================
API_GATEWAY_PORT=5460
ADMIN_PORT=5461
CLIENT_PORT=5462
USER_SERVICE_PORT=5463
PRODUCT_SERVICE_PORT=5464
ORDER_SERVICE_PORT=5465
INVENTORY_SERVICE_PORT=5466
ANALYTICS_SERVICE_PORT=5467

# =================================
# Database (one Supabase Postgres, one schema per service)
# =================================
# The connection base is written ONCE. Each service derives
#   <SERVICE>_DATABASE_URL / <SERVICE>_DIRECT_URL = ${SUPABASE_DB_URL}/postgres?schema=ms_<service>
# for user, order, product, inventory, analytics (schemas ms_user, ms_order, ms_product,
# ms_inventory, ms_analytics). The password must be percent-encoded
# (@ = %40, # = %23, % = %25, ^ = %5E, $ = %24).
# To point ONE service elsewhere (e.g. the transaction pooler on 6543 with
# &pgbouncer=true), set that service's <SERVICE>_DATABASE_URL explicitly; an explicit
# value always wins. Use <SERVICE>_DIRECT_URL (port 5432) for migrations.
DB_MODE=supabase
RELATIONAL_DB_DRIVER=postgres
DOCUMENT_DB_DRIVER=postgres
SUPABASE_DB_URL=postgresql://postgres:your-encoded-password@db.your-project-ref.supabase.co:5432
# DB_POOL_MAX (connections per service; 5 services x this must stay under the project cap), REDIS_DB,
# STORAGE_PROVIDER, RUSTFS_BUCKET/REGION/USE_SSL, ELASTICSEARCH_INDEX default in packages/shared/constants/src (database.ts, storage.ts, search.ts).
# BULLMQ_ORDER_EXPIRATION_MINUTES defaults in packages/shared/constants/src/queues.ts. Env override still works.

# Outbox relay tunables live in packages/shared/constants/src/outbox.ts (env override still works)

# =================================
# Key-Value Cache & Task Queues (Redis / BullMQ)
# =================================
# Other KV drivers (rocksdb | embedded) exist in packages/shared/database/src/config.ts.
KV_CACHE_DRIVER=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =================================
# Object & File Storage (RustFS, S3 API compatible)
# =================================
# Other providers (s3 | local) exist in packages/shared/database/src/storage.ts.
# RustFS host ports moved off 9000/9001 to 6380/6381 on 2026-09-22 in infra-hub, which
# owns this container -- see infra-hub's .env for why.
RUSTFS_ENDPOINT=http://localhost:6380
RUSTFS_CONSOLE_ENDPOINT=http://localhost:6381
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfspassword
# Host directory backing the RustFS bind mount. Owned by the infra-hub repo;
# shown read-only in the admin Persistence panel.
RUSTFS_DATA_PATH=C:\Hub\RustFS

# =================================
# Logging (Loki)
# =================================
# Loki runs in infra-hub behind a compose profile:
#   cd ../infra-hub && docker compose --profile logging up -d
# Services log to the terminal regardless; this adds shipping to Loki. Set false to disable.
LOKI_ENABLED=true
LOKI_HOST=http://localhost:3100

# =================================
# Search (Elasticsearch)
# =================================
ELASTICSEARCH_HOST=http://localhost:9200
# Set false to skip Elasticsearch entirely and use the in-memory substring fallback.
ELASTICSEARCH_ENABLED=true

# =================================
# API defense (change-05): authentication, authorization, rate limiting, CORS
# =================================
# Supabase Auth issues the user tokens; services verify them offline against the project's
# public JWKS (<SUPABASE_URL>/auth/v1/.well-known/jwks.json), so no signing secret lives in any service.
SUPABASE_URL=https://your-project-ref.supabase.co
# Client-safe. Used by the web client and admin SPA (NEXT_PUBLIC_/VITE_ copies are derived from it).
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
# SERVER-ONLY (ms-user admin API: create users, set app_role). Never expose to a browser bundle.
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
# report = log every would-be 401/403/429 but block nothing (rollout). enforce = apply them.
AUTH_ENFORCE=report
RATE_LIMIT_ENFORCE=report
# VITE_MOCK_MFA=true   # dev only: mock the TOTP screen; ignored in production builds
# HS256 secret for short-lived service-to-service tokens (60 s). Only the internal services hold it.
SERVICE_AUTH_SECRET=generate-a-long-random-string
# Comma-separated browser origins allowed by CORS (no wildcard).
CORS_ORIGINS=http://localhost:5461,http://localhost:5462
# Number of trusted reverse-proxy hops in front of a service (0/false when clients connect directly).
TRUST_PROXY=false
# Per-minute rate limit tunables live in packages/shared/constants/src/rateLimit.ts (env override still works)

# =================================
# Monitoring
# =================================
PROMETHEUS_PORT=9090

# =================================
# Event backbone (Kafka / Redpanda)
# =================================
# OPTIONAL. With KAFKA_ENABLED=false nothing is constructed, no sockets are opened, and
# GET /api/v1/events reports enabled:false. Outbox events wait in the table until enabled.
# The broker lives in infra-hub:  cd ../../infra-hub && docker compose --profile kafka up -d
# Console (topics, messages, consumer lag): http://localhost:9102
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9100
