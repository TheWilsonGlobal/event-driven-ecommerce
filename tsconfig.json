{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./",
    "removeComments": false,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": false,
    "noUncheckedIndexedAccess": false,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@ecommerce/shared": ["packages/shared/src"],
      "@ecommerce/shared-types": ["packages/shared/types/src"],
      "@ecommerce/shared-utils": ["packages/shared/utils/src"],
      "@ecommerce/shared-database": ["packages/shared/database/src"],
      "@ecommerce/shared-messaging": ["packages/shared/messaging/src"],
      "@ecommerce/gateway": ["packages/gateway/src"],
      "@ecommerce/ms-user": ["packages/ms-user/src"],
      "@ecommerce/ms-product": ["packages/ms-product/src"],
      "@ecommerce/ms-order": ["packages/ms-order/src"],
      "@ecommerce/frontend": ["packages/frontend/src"]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "packages/shared/*/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts"
  ],
  "references": [
    { "path": "./packages/shared" },
    { "path": "./packages/shared/types" },
    { "path": "./packages/shared/utils" },
    { "path": "./packages/shared/database" },
    { "path": "./packages/shared/messaging" },
    { "path": "./packages/gateway" },
    { "path": "./packages/ms-user" },
    { "path": "./packages/ms-product" },
    { "path": "./packages/ms-order" },
    { "path": "./packages/frontend" }
  ]
}