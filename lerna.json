{
  "version": "1.0.0",
  "npmClient": "pnpm",
  "command": {
    "publish": {
      "conventionalCommits": true,
      "message": "chore(release): publish packages",
      "registry": "https://registry.npmjs.org/"
    },
    "bootstrap": {
      "ignore": "component-*"
    }
  },
  "packages": [
    "packages/*",
    "packages/shared/*"
  ],
  "ignoreChanges": [
    "**/*.md",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/stories/**"
  ]
}