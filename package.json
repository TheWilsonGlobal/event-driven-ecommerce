{
  "name": "microservices-ecommerce",
  "version": "1.0.0",
  "description": "A scalable microservices e-commerce platform built with Node.js, TypeScript, and React",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "dev": "concurrently \"pnpm run dev:api-gateway\" \"pnpm run dev:user-service\" \"pnpm run dev:product-service\" \"pnpm run dev:order-service\" \"pnpm run dev:frontend\"",
    "dev:api-gateway": "pnpm --filter @ecommerce/api-gateway dev",
    "dev:user-service": "pnpm --filter @ecommerce/user-service dev",
    "dev:product-service": "pnpm --filter @ecommerce/product-service dev",
    "dev:order-service": "pnpm --filter @ecommerce/order-service dev",
    "dev:frontend": "pnpm --filter @ecommerce/frontend dev",
    "build": "pnpm -r run build",
    "build:shared": "pnpm --filter \"@ecommerce/shared*\" run build",
    "test": "pnpm -r run test",
    "test:watch": "pnpm -r run test:watch",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "clean": "pnpm -r exec rimraf dist && rimraf node_modules pnpm-lock.yaml",
    "bootstrap": "pnpm install",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "concurrently": "^8.2.2",
    "rimraf": "^5.0.5",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "prettier": "^3.1.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/microservices-ecommerce.git"
  },
  "author": "Your Name",
  "license": "MIT",
  "keywords": [
    "microservices",
    "ecommerce",
    "nodejs",
    "typescript",
    "react",
    "docker",
    "kubernetes",
    "pnpm"
  ]
}