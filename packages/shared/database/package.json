{
  "name": "@ecommerce/shared-database",
  "version": "1.0.0",
  "description": "Database connection and models shared across services",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "migrate": "typeorm migration:run",
    "migrate:revert": "typeorm migration:revert",
    "migrate:generate": "typeorm migration:generate",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "typeorm": "^0.3.17",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "ioredis": "^5.3.2",
    "mongoose": "^8.0.3",
    "reflect-metadata": "^0.1.13"
  },
  "devDependencies": {
    "@types/pg": "^8.10.9",
    "@types/jest": "^29.5.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.0"
  }
}