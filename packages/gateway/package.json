{
  "name": "@ecommerce/api-gateway",
  "version": "1.0.0",
  "description": "API Gateway for routing and handling external requests",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "dependencies": {
    "@ecommerce/shared": "workspace:*",
    "@ecommerce/shared-types": "workspace:*",
    "@ecommerce/shared-utils": "workspace:*",
    "fastify": "^4.24.3",
    "@fastify/helmet": "^11.1.1",
    "@fastify/cors": "^8.5.0",
    "@fastify/rate-limit": "^9.0.1",
    "@fastify/compress": "^6.5.0",
    "@fastify/http-proxy": "^9.3.0",
    "@fastify/swagger": "^8.12.0",
    "@fastify/swagger-ui": "^2.0.1",
    "@fastify/jwt": "^7.2.4",
    "dotenv": "^16.3.1",
    "axios": "^1.6.2",
    "pino-pretty": "^10.2.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/jest": "^29.5.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.0"
  }
}