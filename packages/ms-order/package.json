{
  "name": "@ecommerce/ms-order",
  "version": "1.0.0",
  "description": "Order processing and management service",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "prisma:generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@ecommerce/shared-database": "workspace:*",
    "@ecommerce/shared-messaging": "workspace:*",
    "@ecommerce/shared-types": "workspace:*",
    "@ecommerce/shared-utils": "workspace:*",
    "@fastify/cors": "^8.5.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/swagger": "^8.12.0",
    "@fastify/swagger-ui": "^2.0.1",
    "@prisma/client": "^5.10.2",
    "bullmq": "^4.11.4",
    "dotenv": "^16.3.1",
    "fastify": "^4.24.3",
    "ioredis": "^5.3.2",
    "kafkajs": "^2.2.4",
    "kafkajs-snappy": "^1.1.0",
    "paypal-rest-sdk": "^1.8.1",
    "pdfkit": "^0.14.0",
    "pino-pretty": "^10.2.3",
    "qrcode": "^1.5.3",
    "stripe": "^14.9.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@types/paypal-rest-sdk": "^1.7.9",
    "@types/pdfkit": "^0.12.12",
    "@types/qrcode": "^1.5.5",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prisma": "^5.10.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.0"
  }
}
