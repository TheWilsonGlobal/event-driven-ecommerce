{
  "name": "@ecommerce/product-service",
  "version": "1.0.0",
  "description": "Product catalog and inventory management service",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "migrate": "typeorm migration:run",
    "migrate:revert": "typeorm migration:revert"
  },
  "dependencies": {
    "@ecommerce/shared": "^1.0.0",
    "@ecommerce/shared-types": "^1.0.0",
    "@ecommerce/shared-utils": "^1.0.0",
    "@ecommerce/shared-database": "^1.0.0",
    "express": "^4.18.2",
    "dotenv": "^16.3.1",
    "express-validator": "^7.0.1",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.32.6",
    "express-fileupload": "^1.4.3",
    "elasticsearch": "^16.7.3",
    "@elastic/elasticsearch": "^8.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/express-fileupload": "^1.4.4",
    "@types/node": "^20.10.0",
    "@types/jest": "^29.5.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.0"
  }
}