{
  "name": "@ecommerce/admin-classic",
  "version": "1.0.0",
  "description": "Admin dashboard showing all microservices status, architecture and configurations",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3005",
    "build": "tsc && vite build",
    "preview": "vite preview --port 3005",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@ecommerce/shared-types": "workspace:*",
    "@ecommerce/shared-utils": "workspace:*",
    "clsx": "^2.0.0",
    "react-icons": "^4.12.0",
    "date-fns": "^2.30.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.39",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
