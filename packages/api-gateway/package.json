{
  "name": "@ecommerce/api-gateway",
  "version": "1.0.0",
  "description": "API Gateway for routing and handling external requests",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "dependencies": {
    "@ecommerce/shared": "workspace:*",
    "@ecommerce/shared-types": "workspace:*",
    "@ecommerce/shared-utils": "workspace:*",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "http-proxy-middleware": "^2.0.6",
    "dotenv": "^16.3.1",
    "axios": "^1.6.2",
